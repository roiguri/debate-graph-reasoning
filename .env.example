# Copy to .env and fill in. .env is gitignored and MUST NOT be committed.
#
# Your per-student netapp allocation on the MLWG2026 cluster. Home has no quota
# for a conda env + model weights, so everything lives here instead.
# Find the real value on the cluster with:  echo $HOME    or    ls /home/yandex/MLWG2026
NETAPP=/home/yandex/MLWG2026/<your-username>

# HuggingFace token, only needed for gated models. Create one at
# https://huggingface.co/settings/tokens
HF_TOKEN=
