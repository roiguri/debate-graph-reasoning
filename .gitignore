# Reference articles (downloaded PDFs)
docs/articles/

# Secrets & machine-specific config (holds HF_TOKEN and the real NETAPP path)
.env

# Run outputs (kept locally, not in git)
results/*
!results/.gitkeep

# Derived analysis tables/figures (kept local for now; may be committed later, e.g. P6).
# The README (how to regenerate them) IS committed; the derived CSVs are not.
# Ignore the *contents* (analysis/*) so the README re-include below can apply --
# a whole-dir ignore (analysis/) can't be overridden for a file underneath it.
analysis/*
!analysis/README.md

# LaTeX build artifacts (the .tex/.bib/.sty and the built PDF are committed)
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.log
docs/paper/*.out

# HuggingFace cache, if ever created locally
.hf_cache/
hf_cache/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Provenance stamp written at sync time (docs/cluster-runbook.md); regenerated, never committed.
.git_commit
